# Supabase PostgreSQL connection string
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Long random string used to sign JWTs
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# Used by `npm run seed` to create the first admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@123

# Server
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Frontend (put this in frontend/.env)
VITE_API_URL=http://localhost:5000
